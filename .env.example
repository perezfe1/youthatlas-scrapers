# ── Supabase ──────────────────────────────────────────────────────────────────
# Supabase project URL (used by all workflows)
SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase service role key — bypasses RLS — keep secret (used by all workflows)
SUPABASE_SERVICE_KEY=your-service-role-key-here

# ── Anthropic ─────────────────────────────────────────────────────────────────
# Claude API key — used by ingest pipeline only
ANTHROPIC_API_KEY=sk-ant-your-key-here

# ── Telegram ──────────────────────────────────────────────────────────────────
# Bot token for sending messages (all workflows use this for health monitoring)
TELEGRAM_BOT_TOKEN=your-bot-token-here

# Admin monitoring channel ID — receives pipeline health reports (e.g. -100123456789)
TELEGRAM_CHANNEL_ID=-100your-admin-channel-id

# Public channel ID for opportunity posts — @youthatlas1 (distribute-telegram.yml only)
TELEGRAM_PUBLIC_CHANNEL_ID=-100your-public-channel-id

# Your personal Telegram numeric user ID (for admin alerts)
ADMIN_TELEGRAM_ID=your-numeric-user-id

# ── Kit (ConvertKit) ──────────────────────────────────────────────────────────
# Kit API secret — used for v3 broadcasts and v4 subscriber listing (weekly-digest.yml only)
KIT_API_SECRET=your-kit-api-secret-here
