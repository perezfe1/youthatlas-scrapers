{
  "name": "youthatlas-scrapers",
  "version": "0.1.0",
  "type": "module",
  "private": false,
  "scripts": {
    "scrape": "tsx --env-file .env src/pipeline/run.ts",
    "pipeline": "tsx --env-file .env src/pipeline/run.ts",
    "pipeline:dry": "tsx --env-file .env src/pipeline/run.ts --dry-run --limit=3",
    "pipeline:ci": "tsx src/pipeline/run.ts",
    "scrape:youthop": "tsx --env-file .env src/scrapers/run-youthop.ts",
    "scrape:ofy": "tsx --env-file .env src/scrapers/run-ofy.ts",
    "scrape:opdesk": "tsx --env-file .env src/scrapers/run-opdesk.ts",
    "scrape:afterschool": "tsx --env-file .env src/scrapers/run-afterschool.ts",
    "scrape:scholads": "tsx --env-file .env src/scrapers/run-scholads.ts",
    "process": "tsx --env-file .env src/processing/extract.ts",
    "dedup:test": "tsx --env-file .env src/processing/dedup-test.ts",
    "store": "tsx --env-file .env src/processing/store.ts",
    "store:test": "tsx --env-file .env src/processing/store-test.ts",
    "telegram:test": "tsx --env-file .env src/lib/telegram-test.ts",
    "distribute:telegram": "tsx --env-file .env src/distribution/run-telegram.ts",
    "distribute:telegram:ci": "tsx src/distribution/run-telegram.ts",
    "distribute:email": "tsx src/distribution/email-digest.ts",
    "digest:email": "tsx --env-file .env src/distribution/run-email-digest.ts",
    "digest:email:ci": "tsx src/distribution/run-email-digest.ts",
    "reminders": "tsx --env-file .env src/reminders/run-reminders.ts",
    "reminders:ci": "tsx src/reminders/run-reminders.ts",
    "digest:personalized": "tsx --env-file .env src/distribution/personalized/run-personalized-digest.ts",
    "digest:personalized:ci": "tsx src/distribution/personalized/run-personalized-digest.ts",
    "push": "tsx --env-file .env src/distribution/push/run-push.ts",
    "push:ci": "tsx src/distribution/push/run-push.ts",
    "onboarding:email": "tsx --env-file .env src/distribution/onboarding/run-onboarding-email.ts",
    "onboarding:email:ci": "tsx src/distribution/onboarding/run-onboarding-email.ts",
    "backfill:embeddings": "tsx --env-file .env src/processing/backfill-embeddings.ts",
    "migrate:combined": "cat supabase/migrations/*.sql",
    "type-check": "tsc --noEmit",
    "build": "tsc"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "@supabase/supabase-js": "2.58.0",
    "crawlee": "3.12.1",
    "fuzzball": "2.1.3",
    "openai": "^6.27.0",
    "playwright": "1.58.2",
    "resend": "^6.9.3",
    "web-push": "^3.6.7",
    "zod": "3.24.1"
  },
  "devDependencies": {
    "@types/node": "22.10.2",
    "@types/web-push": "^3.6.4",
    "tsx": "4.21.0",
    "typescript": "5.6.3"
  }
}
